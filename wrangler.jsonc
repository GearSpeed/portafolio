{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Debe coincidir con el nombre del Worker en Cloudflare, o Workers Builds rechaza el despliegue.
  "name": "portafolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Salida de `npm run build`; incluye _headers con la CSP y las cabeceras de caché.
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Solo el formulario ejecuta código; el resto se sirve como archivo estático.
    "run_worker_first": ["/api/*"],
  },
  // Variables públicas del formulario. Las claves (TURNSTILE_SECRET_KEY, RESEND_API_KEY) van
  // como *Secret* en el panel: `wrangler deploy` conserva los secretos pero borra las
  // variables de texto creadas a mano, por eso estas viven aquí.
  "vars": {
    // Cloudflare Email Routing reenvía contacto@ al buzón personal, que así no queda en el repo.
    "CONTACTO_DESTINO": "contacto@omarsampayo.dev",
    "CONTACTO_REMITENTE": "Portafolio <contacto@omarsampayo.dev>",
  },
  "observability": { "enabled": true },
}
