{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Debe coincidir con el nombre del Worker en Cloudflare, o Workers Builds rechaza el despliegue.
  "name": "portafolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Salida de `npm run build`; incluye _headers con la CSP y las cabeceras de caché.
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Solo el formulario ejecuta código; el resto se sirve como archivo estático.
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
}
