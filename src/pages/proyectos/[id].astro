---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import { perfil } from '../../data/sitio';

export async function getStaticPaths() {
  const proyectos = (await getCollection('proyectos')).sort((a, b) => a.data.orden - b.data.orden);
  return proyectos.map((proyecto, i) => ({
    params: { id: proyecto.id },
    props: { proyecto, siguiente: proyectos[(i + 1) % proyectos.length] },
  }));
}

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
  siguiente: CollectionEntry<'proyectos'>;
}

const { proyecto, siguiente } = Astro.props;
const { data } = proyecto;
const { Content, headings } = await render(proyecto);
const indice = headings.filter((h) => h.depth === 2);

const ficha = [
  { etiqueta: 'Cliente', valor: data.cliente },
  { etiqueta: 'Rol', valor: data.rol },
  { etiqueta: 'Periodo', valor: data.periodo },
  { etiqueta: 'Estado', valor: data.estado },
];
---

<Base titulo={`${data.titulo} · Caso de estudio · ${perfil.nombre}`} descripcion={data.descripcionSeo} tipo="article">
  <article>
    <header class="mx-auto max-w-7xl px-4 pt-10 pb-12 md:px-8 lg:px-16 lg:pt-14">
      <a href="/#proyectos" class="inline-flex items-center gap-2 text-label font-medium text-ink-muted hover:text-ink">
        <Icono nombre="arrow-left" tamano={16} /> Volver a proyectos
      </a>

      <p class="rotulo mt-10 tracking-widest">
        Caso de estudio · {data.tipo === 'cliente' ? 'Proyecto de cliente' : 'Proyecto propio'} · {data.sector}
      </p>
      <h1 class="mt-3 max-w-4xl text-display-sm font-bold md:text-display">{data.titulo}</h1>
      <p class="mt-3 max-w-3xl text-h4 font-normal text-ink-muted">{data.subtitulo}</p>

      <!-- Las líneas entre celdas son el fondo asomando por el gap de 1px. -->
      <dl class="mt-10 grid grid-cols-1 gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {
          ficha.map((f) => (
            <div class="bg-canvas p-4">
              <dt class="rotulo">{f.etiqueta}</dt>
              <dd class="mt-1 text-small text-ink">{f.valor}</dd>
            </div>
          ))
        }
      </dl>

      <dl class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3">
        {
          data.cifras.map((c) => (
            <div class="card flex flex-col-reverse justify-end gap-1 p-6">
              <dt class="text-small text-ink-muted">{c.etiqueta}</dt>
              <dd class="text-h3 font-bold text-ink">{c.valor}</dd>
            </div>
          ))
        }
      </dl>

      <figure class="mt-8 overflow-hidden rounded-card border border-line bg-elevated">
        <Image
          src={data.portada}
          alt={data.portadaAlt}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 1280px) 1152px, 100vw"
          loading="eager"
          class="h-auto w-full"
        />
      </figure>
    </header>

    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-4 py-14 md:px-8 lg:grid-cols-12 lg:px-16 lg:py-20">
      <aside class="hidden lg:col-span-3 lg:block" aria-label="Índice del caso">
        <div class="sticky top-24 space-y-10">
          {
            indice.length > 0 && (
              <nav aria-label="En este caso">
                <p class="rotulo mb-3">En este caso</p>
                <ol class="border-l border-line">
                  {indice.map((h) => (
                    <li>
                      <a
                        href={`#${h.slug}`}
                        data-indice={h.slug}
                        class="-ml-px block border-l border-transparent py-1.5 pl-4 text-small text-ink-muted transition-colors hover:text-ink aria-[current=true]:border-ink aria-[current=true]:text-ink"
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            )
          }
          <div>
            <p class="rotulo mb-3">Stack</p>
            <ul class="flex flex-wrap gap-1.5">
              {data.stack.map((t) => <li class="chip">{t}</li>)}
            </ul>
          </div>
        </div>
      </aside>

      <div class="lg:col-span-9">
        <div class="prose-caso">
          <Content />
        </div>

        <div class="mt-12 border-t border-line pt-8 lg:hidden">
          <p class="rotulo mb-3">Stack</p>
          <ul class="flex flex-wrap gap-1.5">
            {data.stack.map((t) => <li class="chip">{t}</li>)}
          </ul>
        </div>

        {
          data.enlaces.length > 0 && (
            <ul class="mt-10 flex flex-wrap gap-3">
              {data.enlaces.map((e) => (
                <li>
                  <a href={e.href} target="_blank" rel="noopener noreferrer" class="btn btn-secundario">
                    {e.texto} <Icono nombre="external-link" tamano={14} />
                    <span class="sr-only">(abre en otra pestaña)</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>

    <nav aria-label="Siguiente caso de estudio" class="mx-auto max-w-7xl px-4 pb-24 md:px-8 lg:px-16">
      <a
        href={`/proyectos/${siguiente.id}/`}
        class="card group flex flex-col gap-2 p-6 transition-colors hover:border-line-strong sm:flex-row sm:items-center sm:justify-between lg:p-8"
      >
        <span>
          <span class="rotulo block">Siguiente caso</span>
          <span class="mt-1 block text-h3 font-semibold text-ink-soft transition-colors group-hover:text-ink">{siguiente.data.titulo}</span>
          <span class="block text-small text-ink-muted">{siguiente.data.subtitulo}</span>
        </span>
        <Icono nombre="arrow-right" tamano={28} class="shrink-0 text-ink" />
      </a>
    </nav>
  </article>
</Base>

<script>
  // Marca en el índice la sección que se está leyendo.
  const enlaces = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-indice]')].map((a) => [a.dataset.indice ?? '', a]),
  );
  const titulos = [...enlaces.keys()].map((id) => document.getElementById(id)).filter((t): t is HTMLElement => t !== null);

  if (titulos.length > 0) {
    const observador = new IntersectionObserver(
      (entradas) => {
        const visible = entradas.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (!visible) return;
        enlaces.forEach((a, id) => a.setAttribute('aria-current', String(id === visible.target.id)));
      },
      { rootMargin: '-80px 0px -65% 0px' },
    );
    titulos.forEach((t) => observador.observe(t));
  }
</script>
