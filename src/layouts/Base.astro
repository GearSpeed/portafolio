---
import '../styles/global.css';
import Encabezado from '../components/Encabezado.astro';
import Pie from '../components/Pie.astro';
import { getImage } from 'astro:assets';
import { perfil } from '../data/sitio';
import foto from '../assets/foto-omar.jpg';

interface Props {
  titulo: string;
  descripcion: string;
  tipo?: 'website' | 'article';
}

const { titulo, descripcion, tipo = 'website' } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenOg = new URL('/img/og.png', Astro.site);
const fotoPerfil = await getImage({ src: foto, width: 512, format: 'jpeg' });

// [x %, y %, radio, opacidad]
const estrellas = [
  [12, 18, 1, 0.6], [28, 8, 0.75, 0.4], [45, 22, 1.2, 0.5], [67, 14, 0.8, 0.7], [82, 29, 1, 0.4], [91, 9, 0.6, 0.5],
  [8, 48, 0.8, 0.3], [23, 62, 1, 0.6], [39, 75, 0.7, 0.4], [58, 52, 1, 0.5], [74, 81, 1.1, 0.6], [88, 66, 0.9, 0.4],
  [95, 44, 0.7, 0.5], [16, 89, 1, 0.4], [52, 94, 0.8, 0.5], [81, 93, 0.75, 0.3],
];

const personaJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: perfil.nombre,
  jobTitle: `${perfil.rol} · ${perfil.rolIA}`,
  email: `mailto:${perfil.correo}`,
  url: Astro.site?.toString(),
  image: new URL(fotoPerfil.src, Astro.site).toString(),
  address: { '@type': 'PostalAddress', addressLocality: 'Ciudad de México', addressCountry: 'MX' },
  sameAs: [perfil.github, perfil.linkedin],
  knowsAbout: ['Angular', 'NestJS', 'Laravel', 'PostgreSQL', 'AWS', 'Cloudflare', 'Automatización con IA'],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <meta name="author" content={perfil.nombre} />
    <meta name="theme-color" content="#050505" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={tipo} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={perfil.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${perfil.nombre} · ${perfil.rol} · ${perfil.rolIA}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(personaJsonLd)} />
    <slot name="head" />
  </head>
  <body class="min-h-dvh">
    <a
      href="#contenido"
      class="sr-only z-[60] rounded-control bg-ink px-4 py-2 font-semibold text-canvas focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Saltar al contenido
    </a>
    <!-- Polvo de estrellas estático del DESIGN.md: casi imperceptible, sin animación. -->
    <svg class="pointer-events-none fixed inset-0 -z-10 size-full opacity-40" aria-hidden="true" focusable="false">
      {
        estrellas.map(([x, y, r, o]) => (
          <circle cx={`${x}%`} cy={`${y}%`} r={r} fill="#fff" opacity={o} />
        ))
      }
    </svg>
    <Encabezado />
    <main id="contenido" class="overflow-x-clip pt-16">
      <slot />
    </main>
    <Pie />
  </body>
</html>
