---
import { contenido } from '../data';
import { cvsPara, idiomaDe } from '../i18n';

const idioma = idiomaDe(Astro.currentLocale);
const { perfil } = contenido(idioma);
const t = {
  es: { lugar: 'Ciudad de México, MX · Hecho con Astro y desplegado en Cloudflare.', correo: 'Correo' },
  en: { lugar: 'Mexico City, MX · Built with Astro and deployed on Cloudflare.', correo: 'Email' },
}[idioma];
const anio = new Date().getFullYear();
---

<footer class="border-t border-line bg-surface">
  <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 px-4 py-16 md:flex-row md:items-center md:px-8 lg:px-16">
    <div class="space-y-1">
      <p class="text-label font-semibold tracking-tight text-ink uppercase">{perfil.nombre} — © {anio}</p>
      <p class="text-small text-ink-muted">{t.lugar}</p>
    </div>
    <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-label font-medium text-ink-muted">
      <li><a class="hover:text-ink" href={perfil.github} rel="noopener noreferrer" target="_blank">GitHub</a></li>
      <li><a class="hover:text-ink" href={perfil.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn</a></li>
      <li><a class="hover:text-ink" href={`mailto:${perfil.correo}`}>{t.correo}</a></li>
      {
        cvsPara(idioma).map((cv) => (
          <li>
            <a class="hover:text-ink" href={cv.href} download hreflang={cv.idioma}>
              {cv.etiqueta[idioma]} (PDF)
            </a>
          </li>
        ))
      }
      <li class="rotulo" aria-hidden="true">UTC-6</li>
    </ul>
  </div>
</footer>
