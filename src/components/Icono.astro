const esMarca = nombre in marcas;
const contenido = esMarca ? marcas[nombre] : trazos[nombre];
if (!contenido) throw new Error(`Ícono desconocido: ${nombre}`);
---

{
  esMarca ? (
    <svg class={clase} width={tamano} height={tamano} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" set:html={contenido} />
  ) : (
    <svg
      class={clase}
      width={tamano}
      height={tamano}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
      set:html={contenido}
    />
  )
}
