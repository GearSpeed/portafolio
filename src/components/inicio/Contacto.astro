---
import Icono from '../Icono.astro';
import { contenido } from '../../data';
import { idiomaDe } from '../../i18n';

const idioma = idiomaDe(Astro.currentLocale);
const { perfil } = contenido(idioma);

// Clave pública de Turnstile; se incrusta al compilar. En desarrollo, si falta, se usa la
// clave de pruebas de Cloudflare. En un build de producción sin clave no se muestra el
// formulario (el widget de pruebas diría «Solo para pruebas»), sino un aviso para escribir
// por correo. Las E2E compilan con la clave de pruebas explícita (playwright.config.ts).
const CLAVE_PRUEBAS = '1x00000000000000000000AA';
const claveTurnstile = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || (import.meta.env.DEV ? CLAVE_PRUEBAS : '');
if (!claveTurnstile) {
  console.warn('[contacto] PUBLIC_TURNSTILE_SITE_KEY no está definida: el formulario se sustituye por un aviso.');
}

// Los tipos viajan tal cual en el asunto del correo; la función los limita a 100 caracteres.
const t = {
  es: {
    rotulo: '05 / Colaboración y contacto',
    titulo: '¿Tienes un proyecto, sistema o desafío en mente?',
    intro:
      'Hablemos con claridad. Puedo ayudarte a analizar la viabilidad técnica, modernizar un sistema heredado o automatizar un proceso, o sumarme a tu equipo.',
    garantias: ['Sin jerga técnica innecesaria', 'Enfoque en el problema de negocio, no solo en el código', 'Respondo personalmente cada mensaje'],
    canal: 'Canal directo',
    lugar: 'Ciudad de México · UTC-6',
    pestana: ' (abre en otra pestaña)',
    nombre: 'Tu nombre o empresa',
    nombreEjemplo: 'Nombre o empresa',
    correo: 'Correo electrónico',
    correoEjemplo: 'correo@dominio.com',
    tipo: 'Tipo de proyecto o necesidad',
    tipos: [
      'Modernizar un sistema existente o resolver una falla',
      'Desarrollar un producto o plataforma web nueva',
      'Automatizar procesos o integrar IA',
      'Oferta de empleo o colaboración',
      'Otro',
    ],
    mensaje: 'Cuéntame brevemente sobre tu reto',
    mensajeEjemplo: '¿Qué objetivo buscas y en qué fase está tu iniciativa?',
    trampa: 'No llenar este campo',
    enviar: 'Enviar mensaje →',
    mantenimiento: 'Formulario en mantenimiento',
    mantenimientoTexto: 'Mientras tanto, escríbeme directo por correo y te respondo personalmente.',
    navegador: {
      revisa: 'Revisa los campos: nombre, un correo válido y un mensaje de al menos 10 caracteres.',
      espera: 'Espera un momento a que termine la verificación antispam e inténtalo de nuevo.',
      enviando: 'Enviando…',
      enviado: '✓ Mensaje enviado. Te responderé pronto.',
      fallo: 'No se pudo enviar el mensaje. Escríbeme directo por correo.',
      sinConexion: 'No hubo conexión. Inténtalo de nuevo o escríbeme directo por correo.',
      enviar: 'Enviar mensaje →',
    },
  },
  en: {
    rotulo: '05 / Collaboration and contact',
    titulo: 'Do you have a project, system or challenge in mind?',
    intro:
      "Let's talk plainly. I can help you assess technical feasibility, modernize a legacy system or automate a process, or join your team.",
    garantias: ['No unnecessary technical jargon', 'Focused on the business problem, not just the code', 'I answer every message personally'],
    canal: 'Direct channel',
    lugar: 'Mexico City · UTC-6',
    pestana: ' (opens in a new tab)',
    nombre: 'Your name or company',
    nombreEjemplo: 'Name or company',
    correo: 'Email',
    correoEjemplo: 'email@domain.com',
    tipo: 'Type of project or need',
    tipos: [
      'Modernize an existing system or fix a failure',
      'Build a new product or web platform',
      'Automate processes or integrate AI',
      'Job offer or collaboration',
      'Other',
    ],
    mensaje: 'Tell me briefly about your challenge',
    mensajeEjemplo: 'What are you aiming for and what stage is your initiative at?',
    trampa: 'Do not fill in this field',
    enviar: 'Send message →',
    mantenimiento: 'Form under maintenance',
    mantenimientoTexto: 'In the meantime, email me directly and I will answer personally.',
    navegador: {
      revisa: 'Check the fields: name, a valid email and a message of at least 10 characters.',
      espera: 'Wait a moment for the anti-spam check to finish and try again.',
      enviando: 'Sending…',
      enviado: '✓ Message sent. I will get back to you soon.',
      fallo: 'The message could not be sent. Email me directly.',
      sinConexion: 'No connection. Try again or email me directly.',
      enviar: 'Send message →',
    },
  },
}[idioma];
---

<section id="contacto" aria-labelledby="contacto-titulo" class="mx-auto w-full max-w-7xl px-4 pt-24 pb-24 md:px-8 lg:px-16">
  <div class="grid grid-cols-1 items-start gap-10 border-t border-line pt-10 lg:grid-cols-12">
    <div class="space-y-4 lg:col-span-5">
      <p class="rotulo tracking-widest">{t.rotulo}</p>
      <h2 id="contacto-titulo" class="text-h3 font-semibold">{t.titulo}</h2>
      <p class="text-body text-ink-soft">{t.intro}</p>
      <ul class="space-y-2 pt-2">
        {
          t.garantias.map((g) => (
            <li class="flex items-center gap-2 text-small text-ink">
              <Icono nombre="check-circle" tamano={18} class="shrink-0" />
              {g}
            </li>
          ))
        }
      </ul>

      <div class="card mt-6 p-4">
        <p class="rotulo">{t.canal}</p>
        <a href={`mailto:${perfil.correo}`} class="mt-1 block text-h4 font-semibold break-all text-ink hover:underline hover:underline-offset-4">
          {perfil.correo}
        </a>
        <p class="mt-0.5 text-small text-ink-muted">{t.lugar}</p>
        <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2 border-t border-line pt-3 text-label font-medium text-ink-muted">
          <li>
            <a href={perfil.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:text-ink">
              <Icono nombre="linkedin" tamano={16} /> LinkedIn<span class="sr-only">{t.pestana}</span>
            </a>
          </li>
          <li>
            <a href={perfil.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:text-ink">
              <Icono nombre="github" tamano={16} /> GitHub<span class="sr-only">{t.pestana}</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    {
      claveTurnstile ? (
        <div class="card p-6 shadow-pop sm:p-10 lg:col-span-7">
          <form id="formulario-contacto" action="/api/contacto" method="post" class="space-y-4" novalidate data-textos={JSON.stringify(t.navegador)}>
            <input type="hidden" name="idioma" value={idioma} />
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
              <div class="space-y-1">
                <label for="contacto-nombre" class="rotulo">{t.nombre}</label>
                <input
                  id="contacto-nombre"
                  name="nombre"
                  type="text"
                  required
                  maxlength="100"
                  autocomplete="name"
                  placeholder={t.nombreEjemplo}
                  class="campo"
                />
              </div>
              <div class="space-y-1">
                <label for="contacto-correo" class="rotulo">{t.correo}</label>
                <input
                  id="contacto-correo"
                  name="correo"
                  type="email"
                  required
                  maxlength="200"
                  autocomplete="email"
                  placeholder={t.correoEjemplo}
                  class="campo"
                />
              </div>
            </div>
  
            <div class="space-y-1">
              <label for="contacto-tipo" class="rotulo">{t.tipo}</label>
              <select id="contacto-tipo" name="tipo" class="campo">
                {t.tipos.map((tipo) => <option value={tipo}>{tipo}</option>)}
              </select>
            </div>
  
            <div class="space-y-1">
              <label for="contacto-mensaje" class="rotulo">{t.mensaje}</label>
              <textarea
                id="contacto-mensaje"
                name="mensaje"
                required
                minlength="10"
                maxlength="5000"
                rows="5"
                placeholder={t.mensajeEjemplo}
                class="campo resize-y"
              ></textarea>
            </div>
  
            {/* Trampa para bots: invisible para personas y lectores de pantalla. */}
            <div class="absolute -left-[9999px]" aria-hidden="true">
              <label for="contacto-sitio">{t.trampa}</label>
              <input id="contacto-sitio" name="sitio_web" type="text" tabindex="-1" autocomplete="off" />
            </div>
  
            <div class="cf-turnstile" data-sitekey={claveTurnstile} data-theme="dark" data-language={idioma} data-size="flexible"></div>
  
            <button type="submit" class="btn btn-primario w-full disabled:cursor-wait disabled:opacity-70">
              <span data-texto-boton>{t.enviar}</span>
            </button>
            <p id="contacto-estado" role="status" aria-live="polite" class="text-small"></p>
          </form>
        </div>
      ) : (
        <div class="card flex flex-col items-start justify-center gap-4 p-6 sm:p-10 lg:col-span-7">
          <p class="rotulo">{t.mantenimiento}</p>
          <p class="text-body text-ink-soft">{t.mantenimientoTexto}</p>
          <a href={`mailto:${perfil.correo}`} class="btn btn-primario">
            <Icono nombre="mail" tamano={16} /> {perfil.correo}
          </a>
        </div>
      )
    }
  </div>
</section>

{claveTurnstile && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  type Respuesta = { ok: boolean; mensaje: string };
  type Turnstile = { reset: () => void };
  type Textos = Record<'revisa' | 'espera' | 'enviando' | 'enviado' | 'fallo' | 'sinConexion' | 'enviar', string>;

  const formulario = document.getElementById('formulario-contacto') as HTMLFormElement | null;
  // Mensajes en el idioma de la página, desde el atributo data-textos del formulario.
  const t = JSON.parse(formulario?.dataset.textos ?? '{}') as Textos;
  const estado = document.getElementById('contacto-estado');
  const boton = formulario?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const textoBoton = boton?.querySelector<HTMLElement>('[data-texto-boton]');

  function mostrar(texto: string, exito: boolean) {
    if (!estado) return;
    estado.textContent = texto;
    estado.className = `text-small ${exito ? 'text-ink' : 'text-danger'}`;
  }

  formulario?.addEventListener('submit', async (evento) => {
    evento.preventDefault();

    if (!formulario.checkValidity()) {
      const invalido = formulario.querySelector<HTMLInputElement | HTMLTextAreaElement>(':invalid');
      mostrar(t.revisa, false);
      invalido?.focus();
      return;
    }

    const datos = new FormData(formulario);
    if (!datos.get('cf-turnstile-response')) {
      mostrar(t.espera, false);
      return;
    }

    if (boton) boton.disabled = true;
    if (textoBoton) textoBoton.textContent = t.enviando;
    mostrar('', true);

    try {
      const respuesta = await fetch(formulario.action, {
        method: 'POST',
        body: datos,
        headers: { Accept: 'application/json' },
      });
      const cuerpo = (await respuesta.json().catch(() => null)) as Respuesta | null;
      if (respuesta.ok && cuerpo?.ok) {
        formulario.reset();
        mostrar(t.enviado, true);
      } else {
        mostrar(cuerpo?.mensaje ?? t.fallo, false);
      }
    } catch {
      mostrar(t.sinConexion, false);
    } finally {
      (window as unknown as { turnstile?: Turnstile }).turnstile?.reset();
      if (boton) boton.disabled = false;
      if (textoBoton) textoBoton.textContent = t.enviar;
    }
  });
</script>
