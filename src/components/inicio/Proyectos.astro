---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Seccion from '../Seccion.astro';
import { contenido } from '../../data';
import { idiomaDe, rutas } from '../../i18n';

const idioma = idiomaDe(Astro.currentLocale);
const { categoriasProyecto } = contenido(idioma);
const t = {
  es: {
    etiqueta: 'Portafolio',
    titulo: 'Proyectos seleccionados',
    intro: 'Una plataforma bancaria en tres países, un sistema de ventas en uso diario con su sitio web y un pipeline de video con IA.',
    todos: 'Todos',
    filtrar: 'Filtrar proyectos por categoría',
    cliente: 'Proyecto de cliente',
    propio: 'Proyecto propio',
    problema: 'Problema:',
    solucion: 'Solución:',
    resultado: 'Resultado:',
    tecnologias: 'Tecnologías principales',
    ver: 'Ver caso de estudio →',
    singular: 'proyecto',
    plural: 'proyectos',
  },
  en: {
    etiqueta: 'Portfolio',
    titulo: 'Selected projects',
    intro: 'A banking platform in three countries, a sales system in daily use with its website and an AI video pipeline.',
    todos: 'All',
    filtrar: 'Filter projects by category',
    cliente: 'Client project',
    propio: 'Personal project',
    problema: 'Problem:',
    solucion: 'Solution:',
    resultado: 'Result:',
    tecnologias: 'Main technologies',
    ver: 'See case study →',
    singular: 'project',
    plural: 'projects',
  },
}[idioma];

const proyectos = (await getCollection(idioma === 'en' ? 'proyectosEn' : 'proyectos')).sort((a, b) => a.data.orden - b.data.orden);
const filtros = [['todos', t.todos], ...Object.entries(categoriasProyecto)];
---

<Seccion
  id="proyectos"
  numero="02"
  etiqueta={t.etiqueta}
  titulo={t.titulo}
  intro={t.intro}
>
  <!-- Los filtros solo se muestran con JavaScript; sin él se ven todos los proyectos. -->
  <div class="mb-6 flex flex-wrap items-center gap-3" data-filtros hidden>
    <div role="group" aria-label={t.filtrar} class="inline-flex flex-wrap gap-1.5 rounded-control border border-line bg-surface p-1">
      {
        filtros.map(([valor, texto]) => (
          <button
            type="button"
            data-filtro={valor}
            aria-pressed={valor === 'todos' ? 'true' : 'false'}
            class="rounded-md px-3 py-1 text-small font-medium text-ink-muted transition-colors hover:text-ink aria-pressed:bg-ink aria-pressed:text-canvas"
          >
            {texto}
          </button>
        ))
      }
    </div>
    <p class="sr-only" role="status" aria-live="polite" data-filtros-estado data-singular={t.singular} data-plural={t.plural}></p>
  </div>

  <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
    {
      proyectos.map(({ id, data }) => (
        <li data-categoria={data.categoria}>
          <article class="card group relative flex h-full flex-col overflow-hidden transition-colors hover:border-line-strong">
            <div class="relative h-52 overflow-hidden border-b border-line bg-elevated">
              {/* Monocromo por defecto; el color aparece al pasar el cursor o, en celular y tableta,
                  cuando la tarjeta cruza la franja central de la pantalla (data-en-foco). */}
              <Image
                src={data.portada}
                alt={data.portadaAlt}
                widths={[480, 800, 1200]}
                sizes="(min-width: 1280px) 368px, (min-width: 768px) 50vw, 100vw"
                class="size-full object-cover object-top contrast-110 grayscale transition-[filter] duration-500 group-hover:grayscale-0 max-md:group-data-en-foco:grayscale-0 [@media(hover:none)]:group-data-en-foco:grayscale-0"
              />
              <span class="rotulo absolute top-4 left-4 rounded-sm border border-line bg-canvas/85 px-2 py-0.5" aria-hidden="true">{data.sector}</span>
            </div>

            <div class="flex flex-1 flex-col justify-between gap-6 p-6">
              <div>
                <p class="rotulo">
                  {data.tipo === 'cliente' ? t.cliente : t.propio} · {data.estado}
                </p>
                <h3 class="mt-1 text-h4 font-semibold">
                  <a href={rutas.proyecto(idioma, id)} class="after:absolute after:inset-0 after:content-['']">
                    {data.titulo}
                  </a>
                </h3>
                <dl class="mt-3 space-y-2 text-small text-ink-muted">
                  <div>
                    <dt class="inline font-medium text-ink">{t.problema}</dt>
                    <dd class="inline">{data.problema}</dd>
                  </div>
                  <div>
                    <dt class="inline font-medium text-ink">{t.solucion}</dt>
                    <dd class="inline">{data.solucion}</dd>
                  </div>
                  <div>
                    <dt class="inline font-medium text-ink">{t.resultado}</dt>
                    <dd class="inline">{data.resultado}</dd>
                  </div>
                </dl>
              </div>

              <div class="flex flex-col gap-3 border-t border-line pt-4">
                <ul class="flex flex-wrap gap-1.5" aria-label={t.tecnologias}>
                  {data.stack.slice(0, 4).map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                </ul>
                <span class="text-label font-medium text-ink underline-offset-4 group-hover:underline" aria-hidden="true">
                  {t.ver}
                </span>
              </div>
            </div>
          </article>
        </li>
      ))
    }
  </ul>
</Seccion>

<script>
  const contenedor = document.querySelector<HTMLElement>('[data-filtros]');
  const botones = document.querySelectorAll<HTMLButtonElement>('[data-filtro]');
  const tarjetas = document.querySelectorAll<HTMLElement>('[data-categoria]');
  const estado = document.querySelector<HTMLElement>('[data-filtros-estado]');

  if (contenedor) contenedor.hidden = false;

  // En pantallas sin cursor no hay hover: la imagen toma color mientras la tarjeta cruza la
  // franja central de la pantalla y vuelve a blanco y negro al salir. Se marca siempre y el CSS
  // lo aplica en pantallas angostas (una columna) o sin cursor (tabletas), aunque el modo cambie
  // sin recargar.
  const observador = new IntersectionObserver(
    (entradas) => entradas.forEach((e) => e.target.toggleAttribute('data-en-foco', e.isIntersecting)),
    { rootMargin: '-35% 0px -35% 0px' },
  );
  document.querySelectorAll('#proyectos article').forEach((tarjeta) => observador.observe(tarjeta));

  botones.forEach((boton) => {
    boton.addEventListener('click', () => {
      const filtro = boton.dataset.filtro;
      botones.forEach((b) => b.setAttribute('aria-pressed', String(b === boton)));
      let visibles = 0;
      tarjetas.forEach((tarjeta) => {
        const mostrar = filtro === 'todos' || tarjeta.dataset.categoria === filtro;
        tarjeta.hidden = !mostrar;
        if (mostrar) visibles++;
      });
      if (estado) estado.textContent = `${visibles} ${visibles === 1 ? estado.dataset.singular : estado.dataset.plural}`;
    });
  });
</script>
