---
import Icono from './Icono.astro';
import { navegacion, perfil } from '../data/sitio';
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-line bg-canvas/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-4 md:px-8 lg:px-16">
    <a href="/#inicio" class="flex min-w-0 items-center gap-3 rounded-sm">
      <span class="truncate text-label font-semibold tracking-tight text-ink uppercase">{perfil.nombre}</span>
      <span class="hidden size-1.5 shrink-0 rounded-full bg-line-strong sm:inline-block" aria-hidden="true"></span>
      <span class="rotulo hidden tracking-widest sm:inline">Portafolio · CDMX</span>
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-6">
        {
          navegacion.map((enlace) => (
            <li>
              <a href={enlace.href} class="text-label font-medium text-ink-soft transition-colors hover:text-ink">
                {enlace.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/#contacto"
        class="inline-flex items-center rounded-full bg-ink px-4 py-1.5 text-label font-medium whitespace-nowrap text-canvas transition-opacity hover:opacity-90"
      >
        Hablemos →
      </a>
      <button
        type="button"
        id="menu-boton"
        class="inline-flex size-10 items-center justify-center rounded-control text-ink-soft hover:bg-elevated hover:text-ink lg:hidden"
        aria-controls="menu-movil"
        aria-expanded="false"
        aria-label="Abrir menú"
      >
        <Icono nombre="menu" class="icono-abrir" />
        <Icono nombre="x" class="icono-cerrar hidden" />
      </button>
    </div>
  </div>

  <nav id="menu-movil" aria-label="Principal (móvil)" class="hidden border-t border-line bg-elevated shadow-pop lg:hidden">
    <ul class="mx-auto flex max-w-7xl flex-col px-4 py-3 md:px-8">
      {
        navegacion.map((enlace) => (
          <li>
            <a href={enlace.href} class="block rounded-control px-3 py-3 text-body font-medium text-ink-soft hover:bg-surface hover:text-ink">
              {enlace.texto}
            </a>
          </li>
        ))
      }
      <li>
        <a href={perfil.cv} download class="block rounded-control px-3 py-3 text-body font-medium text-ink-soft hover:bg-surface hover:text-ink">
          Descargar CV (PDF)
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const boton = document.getElementById('menu-boton');
  const menu = document.getElementById('menu-movil');

  function cerrar() {
    if (!boton || !menu) return;
    menu.classList.add('hidden');
    boton.setAttribute('aria-expanded', 'false');
    boton.setAttribute('aria-label', 'Abrir menú');
    boton.querySelector('.icono-abrir')?.classList.remove('hidden');
    boton.querySelector('.icono-cerrar')?.classList.add('hidden');
  }

  boton?.addEventListener('click', () => {
    if (!menu) return;
    const abierto = boton.getAttribute('aria-expanded') === 'true';
    if (abierto) return cerrar();
    menu.classList.remove('hidden');
    boton.setAttribute('aria-expanded', 'true');
    boton.setAttribute('aria-label', 'Cerrar menú');
    boton.querySelector('.icono-abrir')?.classList.add('hidden');
    boton.querySelector('.icono-cerrar')?.classList.remove('hidden');
  });

  menu?.addEventListener('click', (evento) => {
    if ((evento.target as HTMLElement).closest('a')) cerrar();
  });

  document.addEventListener('keydown', (evento) => {
    if (evento.key === 'Escape' && boton?.getAttribute('aria-expanded') === 'true') {
      cerrar();
      boton.focus();
    }
  });
</script>
